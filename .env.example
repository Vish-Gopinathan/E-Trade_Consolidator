# Copy to .env and fill in. .env is gitignored — never commit real values.

# E-Trade developer credentials (https://developer.etrade.com)
CONSUMER_KEY=
CONSUMER_SECRET=

# Dashboard login. Prefer APP_PASSWORD_HASH: generate with
#   python -c "import hashlib,secrets;s=secrets.token_hex(16);p=input('password: ');print(f'{s}${hashlib.sha256((s+p).encode()).hexdigest()}')"
APP_PASSWORD_HASH=

# Optional read-only login. Guests see the saved snapshot and cannot refresh
# or edit anything. Leave blank to disable guest access entirely.
GUEST_PASSWORD=
