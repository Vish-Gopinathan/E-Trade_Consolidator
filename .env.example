# Copy to .env and fill in. .env is gitignored — never commit real values.

# E-Trade developer credentials (https://developer.etrade.com)
CONSUMER_KEY=
CONSUMER_SECRET=

# Dashboard login. Prefer APP_PASSWORD_HASH: generate with
#   python -c "import hashlib,secrets;s=secrets.token_hex(16);p=input('password: ');print(f'{s}${hashlib.sha256((s+p).encode()).hexdigest()}')"
APP_PASSWORD_HASH=

# Optional read-only login. Guests see the saved snapshot and cannot refresh
# or edit anything. Leave blank to disable guest access entirely.
GUEST_PASSWORD=

# Where the transaction ledger and holdings snapshot live. Leave blank for a
# local SQLite file in data/ — which is the right choice on a machine whose
# disk persists. Set it to a Postgres connection string (Supabase, Neon, …) to
# reach the same data from anywhere, which a host that wipes its filesystem on
# restart requires. Use the *session pooler* string: the direct connection is
# IPv6-only and will not resolve from most hosts.
SUPABASE_DB_URL=
